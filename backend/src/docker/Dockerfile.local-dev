FROM python:3.12-bookworm

ENV TZ=UTC \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/datamingle/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx \
        mariadb-client \
        build-essential \
        default-libmysqlclient-dev \
        libpq-dev \
        unixodbc-dev \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv4datamingle
ENV PATH="/opt/venv4datamingle/bin:${PATH}"

COPY backend/requirements.txt /tmp/requirements.txt
COPY backend/dev-requirements.txt /tmp/dev-requirements.txt

RUN pip install --upgrade pip \
    && pip install -r /tmp/requirements.txt \
    && pip install -r /tmp/dev-requirements.txt

COPY . /opt/datamingle

RUN useradd -r -s /usr/sbin/nologin nginx || true \
    && cp -f /opt/datamingle/backend/src/docker/nginx.conf /etc/nginx/nginx.conf \
    && mkdir -p /opt/datamingle/backend/logs /opt/datamingle/backend/downloads /opt/datamingle/backend/keys

EXPOSE 9123

ENTRYPOINT ["bash", "/opt/datamingle/backend/src/docker/startup.sh"]
